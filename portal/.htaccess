# Geoportal Ambiental (edición PHP) · Apache / Plesk
Options -Indexes
DirectoryIndex index.html index.php

# config.php contiene la contraseña de la base de datos
<Files "config.php">
    Require all denied
</Files>
<FilesMatch "^\.(user\.ini|git)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/geo+json .geojson
</IfModule>
