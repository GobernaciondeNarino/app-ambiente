# ---------------------------------------------------------------
# Geoportal Ambiental — variables de entorno (copie a .env)
# ---------------------------------------------------------------

# URL pública del geoportal (sin barra final). GeoLibre descarga desde aquí
# los proyectos y los datos, así que debe ser accesible desde el navegador.
GEOPORTAL_PUBLIC_URL=http://localhost:8080
# URL pública de GeoLibre
GEOLIBRE_PUBLIC_URL=http://localhost:8081

# Clave para firmar las sesiones (genere una con: openssl rand -base64 48)
GEOPORTAL_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria

# Usuario administrador inicial (solo se crea si no existen usuarios)
GEOPORTAL_ADMIN_USER=admin
GEOPORTAL_ADMIN_PASSWORD=Cambie-Esta-Clave-2026
GEOPORTAL_ADMIN_EMAIL=

# Límites
GEOPORTAL_MAX_UPLOAD_MB=500
# Capas vectoriales de hasta este tamaño se embeben en el proyecto GeoLibre;
# las más grandes se referencian por URL.
GEOPORTAL_INLINE_MAX_MB=15
GEOPORTAL_TOKEN_HOURS=8

# Base de datos: SQLite por defecto (en el volumen de datos). Para PostgreSQL:
# GEOPORTAL_DATABASE_URL=postgresql+psycopg://usuario:clave@servidor:5432/geoportal

# Documentación interactiva de la API en /api/docs (true/false)
GEOPORTAL_API_DOCS=true

# Puertos publicados por docker compose
GEOPORTAL_PUERTO=8080
GEOLIBRE_PUERTO=8081
GEOLIBRE_VERSION=latest
