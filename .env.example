# ---------------------------------------------------------------
# Geoportal Ambiental — variables de entorno (copie a .env)
# ---------------------------------------------------------------

# URL pública del geoportal, incluido el subdirectorio si lo hay, sin barra final:
#   https://geoportal-ambiental.narino.gov.co   ·   https://www.narino.gov.co/geoportal
# Vacía = se detecta en cada petición (Host, X-Forwarded-Proto y X-Forwarded-Prefix
# que envía el proxy). En producción se recomienda fijarla.
GEOPORTAL_PUBLIC_URL=
# GeoLibre: «local» = Estudio SIG integrado en el geoportal (se instala desde
# Administrador → Estudio SIG, o con scripts/descargar-geolibre.sh); o la URL de una
# instancia externa: https://web.geolibre.app o el servicio «geolibre» de este compose
# (perfil geolibre-separado, http://localhost:8081). También se cambia desde el administrador.
GEOLIBRE_PUBLIC_URL=local

# Clave para firmar las sesiones (genere una con: openssl rand -base64 48)
GEOPORTAL_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria

# Usuario administrador inicial (solo se crea si no existen usuarios)
GEOPORTAL_ADMIN_USER=admin
GEOPORTAL_ADMIN_PASSWORD=Cambie-Esta-Clave-2026
GEOPORTAL_ADMIN_EMAIL=

# Límites
GEOPORTAL_MAX_UPLOAD_MB=500
# Capas vectoriales de hasta este tamaño se embeben en el proyecto GeoLibre;
# las más grandes se referencian por URL.
GEOPORTAL_INLINE_MAX_MB=15
GEOPORTAL_TOKEN_HOURS=8

# Base de datos: SQLite por defecto (en el volumen de datos). Para MySQL/MariaDB o PostgreSQL:
# GEOPORTAL_DATABASE_URL=mysql+pymysql://usuario:clave@servidor:3306/geoportal?charset=utf8mb4
# GEOPORTAL_DATABASE_URL=postgresql+psycopg://usuario:clave@servidor:5432/geoportal

# Documentación interactiva de la API en /api/docs (true/false)
GEOPORTAL_API_DOCS=true

# Puertos publicados por docker compose. Detrás de Plesk u otro proxy use
# GEOPORTAL_IP=127.0.0.1 para que los contenedores no queden expuestos.
GEOPORTAL_IP=0.0.0.0
GEOPORTAL_PUERTO=8080
GEOLIBRE_PUERTO=8081
GEOLIBRE_VERSION=latest
